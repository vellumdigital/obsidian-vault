{
  "choices": [
    {
      "id": "capture-inbox",
      "name": "📥 Captura rápida (Inbox)",
      "type": "Capture",
      "command": true,
      "captureTo": "Inbox/{{DATE:YYYY-MM-DD}}-{{VALUE:nome curto}}.md",
      "captureFormat": {
        "enabled": true,
        "format": "---\ncreated: {{DATE:YYYY-MM-DD HH:mm}}\ntags: [inbox, captura]\n---\n\n# {{VALUE:nome curto}}\n\n{{VALUE:conteudo livre}}"
      },
      "format": {
        "enabled": false,
        "format": ""
      },
      "createFileIfItDoesntExist": {
        "enabled": true,
        "create": true,
        "template": ""
      },
      "openFileInNewTab": {
        "enabled": true,
        "direction": "vertical",
        "focus": true
      },
      "openFile": true,
      "appendLink": false,
      "task": false,
      "prepend": false,
      "fileOpening": {
        "location": "split",
        "direction": "vertical",
        "focus": true,
        "mode": "default"
      }
    },
    {
      "id": "new-client",
      "name": "🚀 Novo cliente",
      "type": "Template",
      "command": true,
      "templatePath": "Templates/Cliente.md",
      "fileNameFormat": {
        "enabled": true,
        "format": "{{VALUE:nome do cliente}}"
      },
      "folder": {
        "enabled": true,
        "folders": [
          "Projects/{{VALUE:nome do cliente}}"
        ],
        "chooseWhenCreatingNote": false
      },
      "fileExistsMode": "Increment the file name",
      "openFile": true,
      "openFileInNewTab": {
        "enabled": false,
        "direction": "vertical",
        "focus": true
      },
      "appendLink": false,
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "focus": true,
        "mode": "default"
      }
    },
    {
      "id": "new-idea",
      "name": "💡 Nova ideia",
      "type": "Template",
      "command": true,
      "templatePath": "Templates/Ideia.md",
      "fileNameFormat": {
        "enabled": true,
        "format": "{{DATE:YYYY-MM-DD}}-{{VALUE:nome curto}}"
      },
      "folder": {
        "enabled": true,
        "folders": [
          "Inbox"
        ],
        "chooseWhenCreatingNote": false
      },
      "openFile": true,
      "openFileInNewTab": {
        "enabled": false
      },
      "appendLink": false,
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "focus": true,
        "mode": "default"
      }
    },
    {
      "id": "new-meeting",
      "name": "🤝 Nova reunião",
      "type": "Template",
      "command": true,
      "templatePath": "Templates/Reuniao.md",
      "fileNameFormat": {
        "enabled": true,
        "format": "{{DATE:YYYY-MM-DD}}-{{VALUE:com quem}}"
      },
      "folder": {
        "enabled": true,
        "folders": [
          "Inbox"
        ],
        "chooseWhenCreatingNote": false
      },
      "openFile": true,
      "appendLink": false,
      "fileOpening": {
        "location": "tab",
        "direction": "vertical",
        "mode": "default",
        "focus": true
      }
    }
  ],
  "inputPrompt": "single-line",
  "persistInputPromptDrafts": true,
  "useSelectionAsCaptureValue": true,
  "devMode": false,
  "templateFolderPath": "Templates",
  "announceUpdates": "none",
  "version": "2.12.0",
  "globalVariables": {},
  "onePageInputEnabled": false,
  "disableOnlineFeatures": true,
  "enableRibbonIcon": false,
  "showCaptureNotification": true,
  "showInputCancellationNotification": false,
  "enableTemplatePropertyTypes": false,
  "dateAliases": {
    "t": "today",
    "tm": "tomorrow",
    "yd": "yesterday",
    "nw": "next week",
    "nm": "next month",
    "ny": "next year",
    "lw": "last week",
    "lm": "last month",
    "ly": "last year"
  },
  "ai": {
    "defaultModel": "Ask me",
    "defaultSystemPrompt": "",
    "promptTemplatesFolderPath": "Prompts",
    "showAssistant": false,
    "providers": [
      {
        "name": "OpenAI",
        "endpoint": "https://api.openai.com/v1",
        "apiKey": "",
        "models": [
          {
            "name": "gpt-3.5-turbo",
            "maxTokens": 4096
          },
          {
            "name": "gpt-3.5-turbo-16k",
            "maxTokens": 16384
          },
          {
            "name": "gpt-3.5-turbo-1106",
            "maxTokens": 16385
          },
          {
            "name": "gpt-4",
            "maxTokens": 8192
          },
          {
            "name": "gpt-4-32k",
            "maxTokens": 32768
          },
          {
            "name": "gpt-4-1106-preview",
            "maxTokens": 128000
          },
          {
            "name": "gpt-4-turbo",
            "maxTokens": 128000
          },
          {
            "name": "gpt-4o",
            "maxTokens": 128000
          },
          {
            "name": "gpt-4o-mini",
            "maxTokens": 128000
          }
        ],
        "autoSyncModels": false,
        "modelSource": "modelsDev"
      },
      {
        "name": "Gemini",
        "endpoint": "https://generativelanguage.googleapis.com",
        "apiKey": "",
        "models": [
          {
            "name": "gemini-1.5-pro",
            "maxTokens": 1000000
          },
          {
            "name": "gemini-1.5-flash",
            "maxTokens": 1000000
          },
          {
            "name": "gemini-1.5-flash-8b",
            "maxTokens": 1000000
          }
        ],
        "autoSyncModels": false,
        "modelSource": "modelsDev"
      }
    ]
  },
  "migrations": {
    "migrateToMacroIDFromEmbeddedMacro": true,
    "useQuickAddTemplateFolder": true,
    "incrementFileNameSettingMoveToDefaultBehavior": true,
    "mutualExclusionInsertAfterAndWriteToBottomOfFile": false,
    "setVersionAfterUpdateModalRelease": true,
    "addDefaultAIProviders": true,
    "removeMacroIndirection": true,
    "migrateFileOpeningSettings": true,
    "backfillFileOpeningDefaults": true,
    "setProviderModelDiscoveryMode": true,
    "migrateProviderApiKeysToSecretStorage": true
  }
}