{
  "commitMessage": "vault: {{date}}",
  "commitDateFormat": "YYYY-MM-DD HH:mm:ss",
  "autoSaveInterval": 5,
  "autoPushInterval": 5,
  "autoPullInterval": 2,
  "autoPullOnBoot": true,
  "disablePush": false,
  "pullBeforePush": true,
  "disablePopups": true,
  "showStatusBar": true,
  "showBranchStatusBar": true,
  "syncMethod": "rebase"
}
