{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(/root/agente/google/cal-add:*)",
      "Bash(/root/agente/google/cal:*)",
      "Bash(/root/agente/google/gmail-send:*)",
      "Bash(/root/agente/google/gmail-thread:*)",
      "Bash(/root/agente/google/gmail:*)",
      "Bash(cal-add:*)",
      "Bash(cal-today:*)",
      "Bash(cat:*)",
      "Bash(date:*)",
      "Bash(find /root/vault:*)",
      "Bash(git -C /root/vault:*)",
      "Bash(gmail-recent:*)",
      "Bash(gmail-send:*)",
      "Bash(gmail-thread:*)",
      "Bash(grep:*)",
      "Bash(ls /root/agente/email-drafts:*)",
      "Bash(ls:*)",
      "Bash(rm /root/agente/email-drafts/*)",
      "Edit(/root/agente/email-drafts/**)",
      "Edit(/root/vault/**)",
      "Glob(/root/vault/**)",
      "Grep(/root/vault/**)",
      "Read(/root/agente/email-drafts/**)",
      "Read(/root/vault/**)",
      "WebFetch",
      "WebSearch",
      "Write(/root/agente/email-drafts/**)",
      "Write(/root/vault/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)"
    ]
  },
  "model": "claude-sonnet-4-6"
}